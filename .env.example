# --- Auth (shared secret pair with the Portal / Vercel) ---
# Worker validates inbound Authorization: Bearer <REEL_WORKER_API_KEY> from the Portal.
REEL_WORKER_API_KEY=
# Worker HMAC-signs its callback body with this; MUST byte-match the Portal's copy.
REEL_WORKER_WEBHOOK_SECRET=

# --- OpenAI (voiceover) ---
# Same key as the Portal. Used for tts-1 narration. Narration is best-effort:
# if this is missing or the call fails, the reel still renders (silent).
OPENAI_API_KEY=

# --- Supabase (mp4 upload target) ---
SUPABASE_URL=https://opjnizbtppkynxzssijy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional overrides (sensible defaults baked in) ---
# Callback target. Default is the www. host — required, or the Portal redirect strips
# the POST body (CLAUDE.md gotcha #1 / Encyclopedia v5_84 line 135). Do not drop www.
PORTAL_CALLBACK_URL=https://www.portalhomehub.com/api/webhooks/reel-complete
REEL_BUCKET=property-videos
TTS_VOICE=nova
# Absolute path to a bundled background-music file. Left blank for now (music is deferred);
# when set, it's mixed under the narration. Reel renders fine without it.
MUSIC_PATH=
